{
  "name": "myapp",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "dotenv -e .env -- turbo run test:e2e",
    "db:generate": "dotenv -e .env -- turbo run db:generate",
    "db:migrate": "dotenv -e .env -- turbo run db:migrate",
    "db:push": "dotenv -e .env -- turbo run db:push",
    "db:studio": "dotenv -e .env -- pnpm --filter @myapp/database db:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md}\""
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.0"
  }
}
